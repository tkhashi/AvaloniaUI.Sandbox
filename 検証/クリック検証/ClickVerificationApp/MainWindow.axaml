<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:ClickVerificationApp.Models"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="ClickVerificationApp.MainWindow"
        Title="クリック操作検証アプリ">
    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Top Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Spacing="10">
            <Button Name="RefreshWindowsButton" Content="ウィンドウ一覧更新" />
            <Button Name="LoadAxElementsButton" Content="選択ウィンドウの要素取得" />
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *">
            <DockPanel Grid.Column="0" Margin="10">
                <TextBlock DockPanel.Dock="Top" Text="1. ウィンドウ選択" FontWeight="Bold" Margin="0,0,0,5" />
                <ListBox Name="WindowsListBox" />
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="10">
                <TextBlock DockPanel.Dock="Top" Text="2. 要素選択と操作" FontWeight="Bold" Margin="0,0,0,5" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                    <Button Name="MoveMouseButton" Content="マウス移動のみ" Background="LightGray" />
                    <Button Name="LeftClickButton" Content="左クリック" Background="LightBlue" />
                    <Button Name="RightClickButton" Content="右クリック" Background="LightGreen" />
                    <Button Name="DoubleLeftClickButton" Content="ダブルクリック(左)" Background="LightPink" />
                </StackPanel>
                <ListBox Name="AxElementsListBox" />
            </DockPanel>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#f0f0f0" BorderBrush="#cccccc" BorderThickness="0,1,0,0">
            <TextBlock Name="StatusTextBlock" Text="準備完了" Margin="10,5" />
        </Border>
    </Grid>
</Window>
